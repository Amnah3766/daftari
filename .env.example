# انسخ هالملف باسم .env.local على جهازك. وعلى Vercel حطها في Settings → Environment Variables.
# الرابط من MongoDB Atlas → Connect → Drivers. حط اسم قاعدة البيانات daftari بعد .net/
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/daftari?retryWrites=true&w=majority
# اختياري (الافتراضي daftari)
MONGODB_DB=daftari
# للجهاز بس، إذا الإنترنت عندك يخرب بحث عناوين Atlas: DNS_SERVERS=1.1.1.1,8.8.8.8
